# Git
.git
.gitignore
.gitattributes

# Dependencies (réinstallées dans l’image)
/node_modules
/vendor

# Environnement (à fournir au runtime)
.env
.env.*
!.env.example

# IDE, OS, cache
.idea
.vscode
*.log
.DS_Store
